# Copy this file to .env. Never commit real credentials.
# Automatic AI priority: OpenCode -> OpenRouter -> Anthropic/Claude -> OpenAI.
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_S=3.0

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=gpt-5.6-terra
# Command name or full path used by --check-usage for local `opencode stats`.
OPENCODE_CLI_PATH=opencode

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_SITE_URL=http://127.0.0.1:8756
OPENROUTER_APP_NAME=AI Stream Co-Director

ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

TWITCH_CHANNEL=
TWITCH_REDIRECT_URI=https://localhost:3000/
TWITCH_USER_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

OBS_WEBSOCKET_PASSWORD=
